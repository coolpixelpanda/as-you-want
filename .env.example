# Postgres on Vercel (Neon, Vercel Postgres, or Prisma Postgres). Required in production.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
#
# Locally, if DATABASE_URL is unset or is not Postgres, JobLink uses SQLite in /data.
DATABASE_URL=""
OPENAI_API_KEY="sk-your-key-here"
OPENAI_MODEL="gpt-4o-mini"
